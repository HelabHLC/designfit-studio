+
+add_shortcode('arbe_fp', function($atts) {
+    $atts = shortcode_atts([
+        'color'=>'',
+        'limit'=>'20',
+        'mode'=>'platform',
+        'show_solver'=>'1',
+    ], $atts);
+
+    $mode = strtolower(trim($atts['mode']));
+
+    // One public entry point:
+    // mode="platform" or default = complete spectral search workflow
+    // mode="registry" = public certificate lookup
+    // mode="card" = compact best formula card
+    // mode="certificate" = certificate only
+    if ($mode === 'registry') {
+        return do_shortcode('[arbe_fp_registry_lookup]');
+    }
+
+    if ($mode === 'card') {
+        return do_shortcode('[arbe_fp_solver_card color="' . esc_attr($atts['color']) . '"]');
+    }
+
+    if ($mode === 'certificate') {
+        return do_shortcode('[arbe_fp_certificate color="' . esc_attr($atts['color']) . '"]');
+    }
+
+    return arbe_fp_render_unified_platform($atts);
+});
+
+function arbe_fp_render_unified_platform($atts) {
+    $requested = arbe_fp_parse_color_query($_GET['fp_color'] ?? $atts['color'] ?? '');
+    $section = strtolower(trim($_GET['arbe_section'] ?? 'search'));
+
+    ob_start();
+    echo '<section class="arbe-solver arbe-fp-unified">';
+    echo '<span class="arbe-kicker">ARBE FP Platform</span>';
+    echo '<h2>One Shortcode Interface</h2>';
+    echo '<p class="arbe-note"><strong>Shortcode:</strong> <code>[arbe_fp]</code> · Suche, SCISSOR, Solver, Certificate und Registry in einer Oberfläche.</p>';
+
+    echo '<div class="arbe-tabs">';
+    $tabs = [
+        'search'=>'Spectral Search',
+        'registry'=>'Registry Lookup',
+    ];
+    foreach ($tabs as $key=>$label) {
+        $url = add_query_arg(['arbe_section'=>$key]);
+        $active = ($section === $key) ? ' arbe-tab-active' : '';
+        echo '<a class="arbe-tab'.$active.'" href="'.esc_url($url).'">'.esc_html($label).'</a>';
+    }
+    echo '</div>';
+
+    if ($section === 'registry') {
+        echo do_shortcode('[arbe_fp_registry_lookup]');
+        echo '</section>';
+        return ob_get_clean();
+    }
+
+    // Default: complete search workflow.
+    echo arbe_fp_render_spectral_search($requested, [
+        'color'=>$requested,
+        'limit'=>$atts['limit'] ?? '20',
+        'show_solver'=>$atts['show_solver'] ?? '1',
+    ]);
+
+    echo '</section>';
+    return ob_get_clean();
+}
+
